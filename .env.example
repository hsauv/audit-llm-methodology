# =============================================================
# Configuration de l'audit LLM — variables d'environnement
# =============================================================
#
# Copiez ce fichier en `.env` et remplissez vos valeurs. `.env` est
# git-ignoré par défaut (voir .gitignore).
#
# Toutes les variables sont OPTIONNELLES en mode simulation : par
# défaut, les notebooks et scripts tournent avec des réponses
# déterministes simulées (utile pour la pédagogie, les démos, la CI).

# --- Mode d'appel API ---
# "true"  : appeler les API LLM réelles (consomme des crédits)
# "false" : mode simulation déterministe (par défaut)
AUDIT_USE_REAL_API=false

# Variante pour le notebook ATS (case_study_ats_matching) :
# "true"  : utiliser des scores simulés par hash (défaut)
# "false" : utiliser le vrai modèle sentence-camembert-large (~1.3 GB)
AUDIT_SIMULATION=true

# --- Provider LLM ---
# Valeurs : "anthropic" (défaut) | "openai"
AUDIT_LLM_PROVIDER=anthropic

# Modèle à auditer — défaut : "claude-sonnet-4-6"
# Exemples valides : claude-sonnet-4-6, claude-opus-4-7, gpt-4o, gpt-4o-mini
AUDIT_LLM_MODEL=claude-sonnet-4-6

# --- Clés API ---
# Renseignez uniquement celles dont vous avez besoin.
# Ne JAMAIS commit ce fichier rempli — utilisez `.env` (gitignored).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Audit name (optionnel) ---
# Défaut généré automatiquement par les notebooks.
# AUDIT_NAME=audit_demo_chatbot_rh
